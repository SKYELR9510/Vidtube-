{
  "name": "vidtube-pc",
  "productName": "Vidtube",
  "version": "1.0.0",
  "description": "Vidtube para PC: videos sin anuncios",
  "author": "Inversiones Silva",
  "main": "main.js",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "dist": "node build.mjs && electron-builder --win nsis --publish never"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "esbuild": "0.24.0",
    "shaka-player": "4.12.6",
    "youtubei.js": "^18.3.0",
    "bgutils-js": "*"
  },
  "build": {
    "appId": "com.silva.vidtube.pc",
    "productName": "Vidtube",
    "artifactName": "Vidtube-Setup-${version}.${ext}",
    "files": ["main.js", "preload.js", "index.html", "dist/**", "assets/**"],
    "directories": { "output": "release" },
    "win": { "target": "nsis", "icon": "assets/icon.ico" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vidtube",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    }
  }
}
